rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Must match AuthService.adminEmail
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'abbasv0786@gmail.com';
    }

    // Portfolio content: public read, admin-only write
    match /projects/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /experiences/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /about_cards/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tech_categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /approach_phases/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /social_links/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /profile/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Visitors can only submit a well-formed message; admin manages them
    match /contact_messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt', 'isRead'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.isRead == false;
      allow read, update, delete: if isAdmin();
    }

    match /config/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
